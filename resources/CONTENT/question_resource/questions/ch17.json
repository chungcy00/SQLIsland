        {
          "id": "B",
          "text": "撤销该事务未提交的更新",
          "explanation": "事务回滚恢复提交前状态。"
        },
        {
          "id": "C",
          "text": "自动创建一个备份文件",
          "explanation": "ROLLBACK不是文件导出功能。"
        },
        {
          "id": "D",
          "text": "删除整个表结构",
          "explanation": "回滚更新不等于DROP TABLE。"
        }
