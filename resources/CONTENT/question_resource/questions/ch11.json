      "difficulty": "简单",
      "type": "代码填空",
      "title": "商品名称末尾两字符",
      "context": "商品名称的后缀用来做简单分组，要取名称最后两个字符。",
      "requirements": "补全空位：取商品名称的最后两个字符作为 suffix；名称不足两个字符时返回现有字符。\n输出列名称及顺序：product_id, suffix。",
      "datasetId": "q0155-lesson",
      "schemaVersion": 3,
      "contentVersion": "3.0.0",
      "sourceTables": [
        "products"
      ],
      "initialCode": "SELECT product_id,{{blank1}} AS suffix FROM products",
      "options": [],
      "acceptedBlanks": [
        {
          "id": "blank1",
          "referenceText": "SUBSTRING(product_name,-2)",
          "acceptedForms": [
            "SUBSTRING(product_name,-2)"
          ]
        }
      ],
      "expectedOutput": {
        "kind": "query",
        "columns": [
          "product_id",
          "suffix"
        ],
        "rows": [
          [
            1,
            "sk"
