    {
      "id": "q0151",
      "chapterId": "ch11",
      "knowledgePointIds": [
        "kp11-03"
      ],
      "primaryKnowledgePointIds": [
        "kp11-03"
      ],
      "difficulty": "简单",
      "type": "独立编写",
      "title": "清除名称两侧空格",
      "context": "导入的名称两侧带有多余空格，要清理后再使用。",
      "requirements": "返回 raw_data 的 id 和清理后的名称 clean_name：只删除名称两端的普通空格，保留内部空格，NULL 保持 NULL。\n输出列名称及顺序：id, clean_name。",
      "datasetId": "q0151-lesson",
      "schemaVersion": 3,
      "contentVersion": "3.0.0",
      "sourceTables": [
        "raw_data"
      ],
      "initialCode": "",
      "options": [],
      "acceptedBlanks": [],
      "expectedOutput": {
        "kind": "query",
        "columns": [
          "id",
          "clean_name"
        ],
        "rows": [
          [
            1,
            "Mask"
          ],
          [
            2,
            "Mask"
          ],
          [
            3,
            "Serum"
          ],
          [
            4,
            "Soap"
          ],
          [
            5,
            "Cream"
          ],
          [
            6,
            ""
          ]
        ],
        "rowCount": 6
      },
      "referenceSolutions": [
        {
          "kind": "reference",
          "mysqlSql": "SELECT id,TRIM(name) AS clean_name FROM raw_data",
          "sqliteSql": "SELECT id,TRIM(name) AS clean_name FROM raw_data"
        },
        {
          "kind": "独立方法等价",
          "mysqlSql": "SELECT id,LTRIM(RTRIM(name)) AS clean_name FROM raw_data",
          "sqliteSql": "SELECT id,LTRIM(RTRIM(name)) AS clean_name FROM raw_data"
        }
      ],
      "hints": [
        "只处理两端，不处理中间。",
        "TRIM(文本) 删除两端的空格；REPLACE 会处理所有位置的字符。",
        "NULL 经过 TRIM 仍是 NULL，不需要额外处理。"
      ],
      "explanation": "TRIM(name) 去掉两端的空格，中间的空格不动，NULL 保持 NULL。\n易错：REPLACE(name,' ','') 会把所有空格都删掉，“Mask A”变成“MaskA”。\n另一种写法：LTRIM(RTRIM(name)) 分别去掉左右两端。",
      "commonErrors": [
        {
          "sql": "SELECT id,REPLACE(name,' ','') AS clean_name FROM raw_data",
          "reason": "REPLACE 会删除所有空格，包括名称内部需要保留的空格。",
          "validation": "典型错误已在至少一组夹具被结果/状态比对拒绝"
        }
      ],
