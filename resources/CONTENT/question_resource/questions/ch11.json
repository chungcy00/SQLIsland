            "er"
          ],
          [
            4,
            "am"
          ],
          [
            5,
            "en"
          ],
          [
            6,
            "_1"
          ]
        ],
        "rowCount": 6
      },
      "referenceSolutions": [
        {
          "kind": "reference",
          "mysqlSql": "SELECT product_id,SUBSTRING(product_name,-2) AS suffix FROM products",
