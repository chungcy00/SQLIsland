        },
        {
          "kind": "关系结构等价",
          "mysqlSql": "SELECT id,store_id,order_date FROM (SELECT * FROM orders) AS orders ORDER BY order_date DESC, store_id",
          "sqliteSql": "SELECT id,store_id,order_date FROM (SELECT * FROM orders) AS orders ORDER BY order_date DESC, store_id",
          "explanation": "先构造派生输入关系，再执行相同投影、聚合和筛选；保持结果语义。"
