        },
        {
          "kind": "代数或函数等价",
          "mysqlSql": "SELECT id,value FROM nullable_values WHERE value IS NULL OR value<>10",
          "sqliteSql": "SELECT id,value FROM nullable_values WHERE value IS NULL OR value<>10"
        }
