      ],
      "difficulty": "入门",
      "type": "独立编写",
      "title": "零值不是缺失",
      "context": "数据质检要区分“值为 0”和“值缺失”这两种情况。",
      "requirements": "从 nullable_values 中找出 value 恰好等于 0 的记录，只输出 id。\n输出字段名称及顺序：id",
      "datasetId": "q0051-lesson",
      "schemaVersion": 3,
      "contentVersion": "3.0.0",
      "sourceTables": [
        "nullable_values"
      ],
      "initialCode": "",
      "options": [],
      "acceptedBlanks": [],
      "expectedOutput": {
        "kind": "query",
        "columns": [
          "id"
        ],
        "rows": [
          [
            2
          ]
        ],
        "rowCount": 1
      },
      "referenceSolutions": [
        {
          "kind": "reference",
          "mysqlSql": "SELECT id FROM nullable_values WHERE value=0",
          "sqliteSql": "SELECT id FROM nullable_values WHERE value=0"
        },
        {
          "kind": "代数或函数等价",
          "mysqlSql": "SELECT id FROM nullable_values WHERE NOT (value<>0)",
          "sqliteSql": "SELECT id FROM nullable_values WHERE NOT (value<>0)"
        }
      ],
      "hints": [
        "0 是一个确定的数值，NULL 表示未知，二者不是一回事。",
        "判断“等于 0”用普通的比较运算；判断“是否缺失”才需要 IS NULL。",
        "检查你的结果里是否混入了 value 为 NULL 的记录。"
      ],
      "explanation": "value=0 只会选中已知且等于 0 的行。NULL 表示“未知”，既不等于 0，也不等于任何数，所以不会被选中。\n易错：用 value IS NULL 得到的是缺失记录，与零值恰好相反。",
      "commonErrors": [
        {
          "sql": "SELECT id FROM nullable_values WHERE value IS NULL",
          "reason": "数值 0 是已知值，NULL 表示未知；IS NULL 选出的是缺失记录。",
          "validation": "典型错误已在至少一组夹具被结果/状态比对拒绝"
        }
      ],
