  "patchSql": [
    "UPDATE salary_history SET bonus_cents=bonus_cents+12345 WHERE salary_id=(SELECT MIN(s.salary_id) FROM salary_history s JOIN employment_history h ON h.employment_id=s.employment_id WHERE h.store_id IS NOT NULL AND s.month_key BETWEEN '2025-01' AND '2025-12')"
  ],
  "patchDescription": "隔离诊断边界数据，允许故意制造来源对账差异；某位门店员工的月奖金提高，销售保持不变，验证人工占比和人效。",
  "patchRowChanges": 1,
  "testIsolation": "每次使用全新数据库副本；夹具可故意引入对账差异或改变业务记录，仅用于判题，绝不可写入基准库",
