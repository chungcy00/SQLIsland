  "patchSql": [
    "UPDATE supplier_invoices SET due_date='2025-12-31' WHERE supplier_invoice_id=(SELECT MIN(supplier_invoice_id) FROM v_invoice_balance WHERE balance_cents>0 AND due_date<'2025-12-31')"
  ],
  "patchDescription": "隔离诊断边界数据，允许故意制造来源对账差异；将一笔逾期未付发票的到期日改为截止日当天，必须归入未逾期。",
  "patchRowChanges": 1,
  "testIsolation": "每次使用全新数据库副本；夹具可故意引入对账差异或改变业务记录，仅用于判题，绝不可写入基准库",
