  "patchSql": [
    "UPDATE returns SET refund_cents=refund_cents+1 WHERE return_id=(SELECT MIN(r.return_id) FROM returns r JOIN order_items i ON i.order_item_id=r.order_item_id JOIN orders o ON o.order_id=i.order_id WHERE o.status='completed' AND o.channel='online' AND o.order_date BETWEEN '2025-01-01' AND '2025-12-31')"
  ],
  "patchDescription": "隔离诊断边界数据，允许故意制造来源对账差异；一条线上有效订单退款增加1分，检验退款率及退款前后利润。",
  "patchRowChanges": 1,
  "testIsolation": "每次使用全新数据库副本；夹具可故意引入对账差异或改变业务记录，仅用于判题，绝不可写入基准库",
