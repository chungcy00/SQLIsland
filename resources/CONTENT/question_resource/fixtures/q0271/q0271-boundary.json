    "UPDATE employees SET termination_date='2025-12-31' WHERE employee_id=(SELECT employee_id FROM employment_history WHERE end_date IS NULL AND start_date<'2025-12-01' ORDER BY employee_id LIMIT 1)",
    "UPDATE employment_history SET end_date='2025-12-31' WHERE end_date IS NULL AND employee_id=(SELECT MIN(employee_id) FROM employees WHERE termination_date='2025-12-31' AND employee_id IN (SELECT employee_id FROM employment_history WHERE end_date IS NULL))"
