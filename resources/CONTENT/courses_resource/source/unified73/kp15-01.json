  "teaching": {
    "problem": "销售分析需同时查看每笔订单及所在类别的总销售额，统计范围为全部五笔订单。",
    "codeExplanation": "订单编号是明细粒度。SUM 计算类别金额，OVER 指定窗口语义，PARTITION BY category 让不同类别互不影响。先比较普通分组的输出，再计算明细贡献率；分母为类别总额而非全表金额，使用 NULLIF 防止零分母。",
    "resultExplanation": "仍为五行。护肤品两笔分别为800和600，均对应1400；化妆品对应700；日用品对应1500。重复出现的类别总额不能再直接求和。",
    "checkpoints": [],
    "mergedConcepts": [],
    "mergeExamples": [
      {
        "label": "普通聚合对照",
        "explanation": "五行缩为三类。",
        "sql": "SELECT category,SUM(sales) AS total FROM orders GROUP BY category ORDER BY total DESC;",
        "result": {
          "columns": [
            "category",
            "total"
          ],
          "rows": [
            [
              "日用品",
              1500
            ],
            [
              "护肤品",
              1400
            ],
            [
              "化妆品",
              700
            ]
          ]
        }
      },
      {
        "label": "类别内贡献率",
        "explanation": "每笔金额除以其类别合计，结果为百分数。",
        "sql": "SELECT id,ROUND(100.0*sales/NULLIF(SUM(sales) OVER(PARTITION BY category),0),2) AS share_pct FROM orders ORDER BY sales DESC;",
