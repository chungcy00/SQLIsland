  "mysqlSql": "SELECT id,category,sales,SUM(sales) OVER(PARTITION BY category) AS category_total FROM orders ORDER BY sales DESC;",
  "sqliteSql": "SELECT id,category,sales,SUM(sales) OVER(PARTITION BY category) AS category_total FROM orders ORDER BY sales DESC;",
  "executionSteps": [
