        "explanation": "四月无交易仍保留。",
        "sql": "WITH RECURSIVE months(month_key) AS (SELECT '2024-01' UNION ALL SELECT strftime('%Y-%m',date(month_key||'-01','+1 month')) FROM months WHERE month_key<'2025-12'),\nstores AS (SELECT 1 AS store_id),\nsales AS (SELECT '2024-01' AS month_key,80 AS net UNION ALL SELECT '2024-12',120 UNION ALL SELECT '2025-01',100 UNION ALL SELECT '2025-02',90 UNION ALL SELECT '2025-03',60 UNION ALL SELECT '2025-05',50),\nb AS (SELECT s.store_id,m.month_key,COALESCE(a.net,0) net FROM stores s CROSS JOIN months m LEFT JOIN sales a ON a.month_key=m.month_key),\np AS (SELECT *,LAG(net) OVER(PARTITION BY store_id ORDER BY month_key) prev,LAG(net,12) OVER(PARTITION BY store_id ORDER BY month_key) prior_year FROM b),\nq AS (SELECT *,CASE WHEN prev>0 AND net<prev THEN 1 ELSE 0 END falling FROM p),\nz AS (SELECT *,SUM(falling) OVER(PARTITION BY store_id ORDER BY month_key ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) fall3 FROM q) SELECT month_key,net FROM b WHERE month_key BETWEEN '2025-01' AND '2025-05' ORDER BY month_key;",
