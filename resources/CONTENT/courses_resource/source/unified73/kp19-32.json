{
  "id": "kp19-32",
  "chapterId": "ch19",
  "title": "销售趋势、同比与环比",
  "learningObjective": "构建连续门店月份并计算环比、同比和连续下滑标志。",
  "prerequisites": [
    "kp19-01",
    "kp19-46"
  ],
  "concept": "环比比较上一自然月，同比比较去年同月。两者均为（本期−基期）÷基期×100%。仅有连续月份和每店每月唯一记录时，窗口偏移1与12才分别对应上月和去年同月。零基期无定义。",
  "syntax": "WITH m AS (SELECT DISTINCT month_key FROM calendar_days WHERE day<='2025-12-31'), a AS (SELECT store_id,SUBSTR(order_date,1,7) m,SUM(net_cents) net FROM v_sales_lines WHERE channel='store' GROUP BY store_id,SUBSTR(order_date,1,7)), b AS (SELECT s.store_id,m.month_key,COALESCE(a.net,0) net FROM stores s CROSS JOIN m LEFT JOIN a ON a.store_id=s.store_id AND a.m=m.month_key), p AS (SELECT *,LAG(net) OVER(PARTITION BY store_id ORDER BY month_key) prev,LAG(net,12) OVER(PARTITION BY store_id ORDER BY month_key) prior_year FROM b), q AS (SELECT *,CASE WHEN prev>0 AND net<prev THEN 1 ELSE 0 END falling FROM p), z AS (SELECT *,SUM(falling) OVER(PARTITION BY store_id ORDER BY month_key ROWS BETWEEN 2 PRECEDING AND CURRENT ROW) fall3 FROM q) SELECT store_id,month_key,net net_cents,ROUND(100.0*(net-prev)/NULLIF(prev,0),2) mom_pct,ROUND(100.0*(net-prior_year)/NULLIF(prior_year,0),2) yoy_pct,CASE WHEN fall3=3 THEN 1 ELSE 0 END three_declines FROM z WHERE month_key BETWEEN '2025-01' AND '2025-12' ORDER BY net_cents DESC",
  "parameters": {
    "统计截止日": "2025-12-31",
    "金额": "整数马币分；比率按题设",
    "输出粒度": "门店×月"
  },
