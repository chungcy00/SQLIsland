  "teaching": {
    "problem": "经营主管需要2025年逐月线下净销售趋势，读取2023—2025年的完整历史轴。无交易且确认数据完整的月份按零处理；缺报不能补零。",
    "codeExplanation": "m 从日历取去重月份，a 按门店与年月汇总，b 交叉连接主档和月份后左接销售。p 在同店分区计算两种偏移；q 按上期为正且本期更低标记下滑，z 用最近三行求和，三个标记都为1才算连续下滑。最终才筛2025，否则一月失去十二月和去年一月。小型示例使用递归表达式生成2024—2025月份，仅用于独立复验。",
    "resultExplanation": "一月100对上月120，环比−16.67%，对去年一月80同比25%；二月环比−10%；三月环比−33.33%，连续三次下滑；四月无交易净额0，环比−100%；五月基期为零，环比未定义。原企业预览一月环比−50.64%、同比31.32%，说明短期与年度表现可以方向不同。",
    "checkpoints": [
      {
        "name": "m",
        "label": "建立连续月份轴",
        "sql": "WITH m AS (SELECT DISTINCT month_key FROM calendar_days WHERE day<='2025-12-31')\nSELECT * FROM m ORDER BY 1 LIMIT 3;",
        "result": {
          "columns": [
            "month_key"
          ],
          "rows": [
            [
              "2023-01"
            ],
            [
              "2023-02"
            ],
            [
              "2023-03"
            ]
          ]
        }
      },
      {
        "name": "a",
        "label": "汇总门店月净销售",
        "sql": "WITH m AS (SELECT DISTINCT month_key FROM calendar_days WHERE day<='2025-12-31'), a AS (SELECT store_id,SUBSTR(order_date,1,7) m,SUM(net_cents) net FROM v_sales_lines WHERE channel='store' GROUP BY store_id,SUBSTR(order_date,1,7))\nSELECT * FROM a ORDER BY 1, 2, 3 LIMIT 3;",
        "result": {
          "columns": [
            "store_id",
            "m",
