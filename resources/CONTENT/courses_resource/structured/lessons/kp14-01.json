  "schemaVersion": 1,
  "id": "kp14-01",
  "sourceBatch": "unified73",
  "teachingKind": "advanced",
  "conceptBlocks": [
    {
      "type": "heading",
      "text": "什么是公用表表达式 CTE？",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "公用表表达式是当前语句内命名的查询结果，不是持久表，也不保证物理物化。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "可以在后续表达式中引用前面已经定义的关系，将复杂分析拆解为可核查的逻辑步骤。"
      ]
    },
    {
      "type": "table",
      "columns": [
        "步骤",
        "一行代表",
        "作用"
      ],
      "rows": [
        [
          "totals",
          "一个类别",
          "计算各类别的销售合计"
        ],
        [
          "qualified",
          "一个类别",
          "保留合计大于 1000 的类别"
        ],
        [
          "最后的 SELECT",
          "一个类别",
          "读取 qualified，按 total 降序排列"
        ]
      ],
      "title": "本例的 CTE 如何一步步拆解",
      "caption": "CTE 只在当前语句内有效，不是持久表。",
      "codeColumns": [
        0
      ]
    },
    {
      "type": "heading",
      "text": "使用要点",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "每个表达式应明确一行代表什么，以及指标计算口径。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "递归形式另有起始项、递归项和终止条件，可处理层级结构；本面试精简版只需了解其用途，不展开递归语法教学。"
      ]
    }
  ],
  "syntax": {
    "purpose": "公用表表达式与多步骤查询的语法模板如下，各部分含义见下方说明。"
  },
  "dataDescriptions": {
    "orders": "共 5 行；字段：id、category、sales、store_id、order_date、customer_id。"
  },
  "problem": "主管需要列出销售额严格超过1000的商品类别。以全部五笔订单为统计范围，按类别汇总金额，再筛选类别；不先排除单笔小额订单。",
  "methodBlocks": [
    {
      "type": "paragraph",
      "text": "先定义 totals，GROUP BY category 将订单粒度变为类别粒度，SUM 计算总额。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "然后定义 qualified，从 totals 读取类别级别结果，使用 WHERE 筛选已计算的 total。此处 WHERE 作用于中间关系的普通列，而非原订单层的聚合表达式。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "最后 SELECT 从 qualified 输出并按金额降序。每个独立检查查询都包含其所需定义；这里描述的是逻辑构建而非优化器物理顺序。",
      "emphasis": []
    }
  ],
  "breakdown": [
    {
      "kind": "runnable",
      "title": "类别销售汇总",
      "sql": "WITH totals AS (SELECT category,SUM(sales) AS total FROM orders GROUP BY category) SELECT * FROM totals ORDER BY total DESC;",
      "purpose": "先算出每个类别的销售合计，放进临时结果 totals。",
      "reason": "把“汇总”单独成一步，后面的筛选只需要对汇总后的结果操作，每一步都可以单独检查。",
