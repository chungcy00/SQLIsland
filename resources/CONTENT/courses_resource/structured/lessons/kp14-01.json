  "extensions": [
    {
      "label": "单层分组筛选对照",
      "explanationBlocks": [
        {
          "type": "paragraph",
          "text": "简单条件可以直接使用 HAVING，不必人为增加表达式。",
          "emphasis": []
        }
      ],
      "sql": "SELECT category,SUM(sales) AS total FROM orders GROUP BY category HAVING SUM(sales)>1000 ORDER BY total DESC;",
      "result": {
        "columns": [
          "category",
          "total"
        ],
        "rows": [
          [
            "日用品",
            1500
          ],
          [
            "护肤品",
            1400
          ]
        ]
      }
    }
  ],
  "cautions": {
    "comparison": [
      {
        "type": "paragraph",
        "text": "具名表达式提高复杂查询可读性；简单查询可直接分组筛选。",
        "emphasis": []
      }
    ],
    "example": [
      {
        "type": "paragraph",
        "text": "同一语句连续写两个 WITH，或在下一条独立语句引用先前的表达式。",
        "emphasis": []
      }
    ],
    "reason": [
      {
        "type": "paragraph",
        "text": "一条语句里只能有一个 WITH，多个临时结果用逗号分隔；连续写两个 WITH，或者在下一条独立的语句里引用上一条语句的临时结果，都会因为找不到名字而报错。",
        "emphasis": []
      }
    ],
    "correction": [
      {
        "type": "paragraph",
        "text": "一个 WITH 后以逗号分隔多个定义，并在同一语句引用。",
        "emphasis": []
      }
    ],
    "notes": [
