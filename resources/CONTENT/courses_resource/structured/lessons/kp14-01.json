    {
      "kind": "runnable",
      "title": "保留符合阈值的类别",
      "sql": "WITH totals AS (SELECT category,SUM(sales) AS total FROM orders GROUP BY category), qualified AS (SELECT category,total FROM totals WHERE total>1000) SELECT * FROM qualified ORDER BY total DESC;",
      "purpose": "再在 totals 的基础上保留合计大于 1000 的类别，放进 qualified，最后按合计从高到低显示。",
      "reason": "同一个 WITH 里用逗号分隔多个临时结果，后面的可以直接使用前面的；每个临时结果只在这一条语句里有效。",
