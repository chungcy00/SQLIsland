          "type": "paragraph",
          "text": "先验证逐张发票的逾期天数，未来到期为负值。",
          "emphasis": []
        }
      ],
      "sql": "WITH v_invoice_balance(supplier_invoice_id,supplier_id,due_date,balance_cents) AS (\n SELECT 1,1,'2025-12-31',1000 UNION ALL SELECT 2,1,'2025-12-01',2000\n UNION ALL SELECT 3,1,'2025-11-30',3000 UNION ALL SELECT 4,1,'2025-11-01',4000\n UNION ALL SELECT 5,1,'2025-10-31',5000 UNION ALL SELECT 6,1,'2025-10-02',6000\n UNION ALL SELECT 7,1,'2025-10-01',7000 UNION ALL SELECT 8,2,'2026-01-15',8000\n UNION ALL SELECT 9,2,'2025-10-01',0 UNION ALL SELECT 10,2,'2025-10-01',-100\n) SELECT supplier_invoice_id,CAST(julianday('2025-12-31')-julianday(due_date) AS INTEGER) days FROM v_invoice_balance WHERE balance_cents>0 ORDER BY supplier_invoice_id",
