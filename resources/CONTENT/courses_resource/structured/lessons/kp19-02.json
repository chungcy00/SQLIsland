{
  "schemaVersion": 1,
  "id": "kp19-02",
  "sourceBatch": "unified73",
  "teachingKind": "business",
  "conceptBlocks": [
    {
      "type": "heading",
      "text": "什么是库存周转率与周转天数？",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "库存金额是某一时点的数量乘单位成本；销售成本是期间流量。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "平均库存取期初与期末库存金额的平均。",
        "周转率=净销售出库成本÷平均库存；周转天数=365×平均库存÷净销售出库成本。"
      ]
    },
    {
      "type": "figure",
      "ids": [
        "kp19-02-turnover",
        "kp19-02-days"
      ]
    },
    {
      "type": "heading",
      "text": "使用要点",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "周转率以次为单位，不能和百分比混淆。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "两端均值是近似值，不能代替高频日均库存。"
      ]
    }
  ],
  "syntax": {
    "purpose": "库存周转率、周转天数与库存金额的语法模板如下，各部分含义见下方说明。"
  },
  "dataDescriptions": {
    "categories": "共 3 行；字段：category_id、category_name。",
    "inventory_snapshots": "共 3 行；字段：snapshot_id、warehouse_id、product_id、snapshot_date、quantity、unit_cost_cents。",
    "products": "共 3 行；字段：product_id、category_id、product_name、list_price_cents、reorder_level、active、discontinued_date。",
    "stock_movements": "共 3 行；字段：movement_id、warehouse_id、product_id、movement_date、movement_type、quantity_delta、unit_cost_cents、order_item_id、receipt_id、return_id、transfer_id、adjustment_id。",
    "warehouses": "共 3 行；字段：warehouse_id、warehouse_name。"
  },
  "problem": "2025全年，按仓库×类别输出。销售出库数量为负，退货入库为正，均取负号乘成本使退货冲减出库成本；采购不计入。期初为2024-12-31，期末为2025-12-31。每仓每商品每个日期必须有唯一快照且金额字段有效；缺失不视为零。无销售成本且库存为正时周转率为0、天数未定义。负净成本需复核。",
  "methodBlocks": [
    {
      "type": "paragraph",
      "text": "先按商品主档把流水归入类别，使用 CASE 仅累计销售与退货；直接对所有出入库求和会混入采购。再交叉连接仓库与类别，匹配商品和指定日期快照，求数量×成本的总额并除2。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "原查询用快照总数等于商品数两倍检测完整性，前提是键唯一；若存在同日期重复，应先检查唯一性，否则一端重复可能掩盖另一端缺失。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "最后左连接两个同粒度汇总，NULLIF 避免零分母，周转天数用未舍入的成本与平均库存计算。",
      "emphasis": []
    }
  ],
  "breakdown": [
    {
      "kind": "runnable",
      "title": "按仓库类别汇总出库成本",
      "sql": "WITH a AS (SELECT warehouse_id,p.category_id,SUM(CASE WHEN movement_type='sale' THEN -quantity_delta*unit_cost_cents WHEN movement_type='return' THEN -quantity_delta*unit_cost_cents ELSE 0 END) cogs FROM stock_movements m JOIN products p ON p.product_id=m.product_id WHERE movement_date BETWEEN '2025-01-01' AND '2025-12-31' GROUP BY warehouse_id,p.category_id)\nSELECT * FROM a ORDER BY 1, 2, 3 LIMIT 3;",
      "purpose": "先按仓库和类别汇总 2025 年的出库成本 cogs。",
      "reason": "销售出库和退货入库都取负号乘以单位成本，退货因此冲减出库成本；采购入库不计入。",
