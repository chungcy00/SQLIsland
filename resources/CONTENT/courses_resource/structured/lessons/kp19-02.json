    {
      "kind": "runnable",
      "title": "期初期末库存价值取平均",
      "sql": "WITH a AS (SELECT warehouse_id,p.category_id,SUM(CASE WHEN movement_type='sale' THEN -quantity_delta*unit_cost_cents WHEN movement_type='return' THEN -quantity_delta*unit_cost_cents ELSE 0 END) cogs FROM stock_movements m JOIN products p ON p.product_id=m.product_id WHERE movement_date BETWEEN '2025-01-01' AND '2025-12-31' GROUP BY warehouse_id,p.category_id), b AS (SELECT w.warehouse_id,c.category_id,CASE WHEN COUNT(i.snapshot_id)=2*COUNT(DISTINCT p.product_id) THEN SUM(i.quantity*i.unit_cost_cents)/2.0 ELSE NULL END avg_stock FROM warehouses w CROSS JOIN categories c LEFT JOIN products p ON p.category_id=c.category_id LEFT JOIN inventory_snapshots i ON i.warehouse_id=w.warehouse_id AND i.product_id=p.product_id AND i.snapshot_date IN ('2024-12-31','2025-12-31') GROUP BY w.warehouse_id,c.category_id)\nSELECT * FROM b ORDER BY 1, 2, 3 LIMIT 3;",
      "purpose": "再取 2024-12-31 期初和 2025-12-31 期末两个日期的库存成本价值，平均后得到平均库存 avg_stock。",
      "reason": "周转率的分母是平均库存；只有每个商品每个日期都有快照时才计算，缺失不当作 0。",
