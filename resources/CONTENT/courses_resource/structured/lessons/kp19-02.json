    {
      "kind": "runnable",
      "title": "计算周转率与周转天数",
      "sql": "WITH a AS (SELECT warehouse_id,p.category_id,SUM(CASE WHEN movement_type='sale' THEN -quantity_delta*unit_cost_cents WHEN movement_type='return' THEN -quantity_delta*unit_cost_cents ELSE 0 END) cogs FROM stock_movements m JOIN products p ON p.product_id=m.product_id WHERE movement_date BETWEEN '2025-01-01' AND '2025-12-31' GROUP BY warehouse_id,p.category_id), b AS (SELECT w.warehouse_id,c.category_id,CASE WHEN COUNT(i.snapshot_id)=2*COUNT(DISTINCT p.product_id) THEN SUM(i.quantity*i.unit_cost_cents)/2.0 ELSE NULL END avg_stock FROM warehouses w CROSS JOIN categories c LEFT JOIN products p ON p.category_id=c.category_id LEFT JOIN inventory_snapshots i ON i.warehouse_id=w.warehouse_id AND i.product_id=p.product_id AND i.snapshot_date IN ('2024-12-31','2025-12-31') GROUP BY w.warehouse_id,c.category_id) SELECT b.warehouse_id,b.category_id,COALESCE(a.cogs,0) cogs_cents,b.avg_stock avg_stock_cents,ROUND(COALESCE(a.cogs,0)/NULLIF(b.avg_stock,0),4) turnover,CASE WHEN a.cogs>0 THEN ROUND(365.0*b.avg_stock/a.cogs,2) ELSE NULL END turnover_days FROM b LEFT JOIN a ON a.warehouse_id=b.warehouse_id AND a.category_id=b.category_id ORDER BY cogs_cents DESC",
      "purpose": "用出库成本除以平均库存得到周转率，用 365 × 平均库存 ÷ 出库成本得到周转天数。",
      "reason": "没有销售成本时天数没有定义，用 CASE 让结果为 NULL，而不是除以 0。",
