{
  "schemaVersion": 1,
  "id": "kp19-50",
  "sourceBatch": "unified73",
  "teachingKind": "business",
  "conceptBlocks": [
    {
      "type": "heading",
      "text": "什么是多规则异常筛查？",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "截至2025年底，重复=同供应商同发票号多张；大额=原始面额严格超过供应商期间内面额均值两倍；超付=净应付减实付小于零；价格差=原面额与本次开票数量按采购单价重算金额的绝对差超过100分。",
      "emphasis": []
    }
  ],
  "syntax": {
    "purpose": "多规则异常交易筛查的语法模板如下，各部分含义见下方说明。"
  },
  "dataDescriptions": {
    "purchase_order_items": "共 3 行；字段：po_item_id、po_id、product_id、contract_id、quantity_ordered、unit_price_cents。",
    "supplier_invoice_items": "共 3 行；字段：supplier_invoice_item_id、supplier_invoice_id、po_item_id、quantity_billed、unit_price_cents。",
    "v_invoice_balance": "共 3 行；字段：supplier_invoice_id、po_id、supplier_id、invoice_no、invoice_date、due_date、billed_cents、paid_cents、balance_cents。"
  },
  "problem": "审计人员优先复核同时命中多项规则的发票，不能将规则当成违规证据。",
  "methodBlocks": [
    {
      "type": "paragraph",
      "text": "f 按发票汇总数量乘单价，采购价也乘同一开票数量。a 窗口计重复次数及供应商面额均值，不能先筛大额再算均值。z 四个 CASE 独立计算，最后相加并筛选。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "净应付含批准贷项，面额不冲减贷项。",
      "emphasis": []
    }
  ],
  "breakdown": [
    {
      "kind": "runnable",
      "title": "核对票面与预期金额",
      "sql": "WITH f AS (\n  SELECT x.supplier_invoice_id,SUM(x.quantity_billed*x.unit_price_cents) face,\n    SUM(x.quantity_billed*p.unit_price_cents) expected\n  FROM supplier_invoice_items x JOIN purchase_order_items p ON p.po_item_id=x.po_item_id\n  GROUP BY x.supplier_invoice_id\n)\nSELECT * FROM f ORDER BY 1, 2, 3 LIMIT 3;",
      "purpose": "先按发票汇总票面金额 face，和用采购单价重算的预期金额 expected。",
      "reason": "价格比较要用同一张发票对应的采购行重算出来的金额，而不是拿别的数字比。",
