  "sourceBatch": "unified73",
  "teachingKind": "business",
  "conceptBlocks": [
    {
      "type": "heading",
      "text": "基本含义",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "任职区间左闭右开：开始日计在职，结束日不计。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "期初取月首日前一天，期末取月末当天。",
        "月离职率=离职人数÷期初期末平均人数；本题滚动三月率=三月离职总数÷三月平均人数之和，不是三个月累计离职率。"
      ]
    }
  ],
  "syntax": {
    "purpose": "人员规模变动与离职率的语法模板如下，各部分含义见下方说明。"
  },
  "dataDescriptions": {
    "calendar_days": "共 3 行；字段：day、month_key、day_index。",
    "departments": "共 3 行；字段：department_id、department_name。",
    "employees": "共 3 行；字段：employee_id、employee_name、hire_date、termination_date。",
    "employment_history": "共 3 行；字段：employment_id、employee_id、department_id、position_id、store_id、start_date、end_date。"
  },
  "problem": "人资主管比较部门人员流动；调岗只改变任职部门，不代表企业离职。保留2024年11、12月历史用于2025年1月滚动计算。",
  "methodBlocks": [
    {
      "type": "paragraph",
      "text": "m 取得每月首末日；a 通过部门与月份交叉连接保留空部门，按任职区间判断在职。真实离职要求员工终止日期在当月且任职结束日等于终止日。b 计算两端均值；",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "z 按部门窗口累加人数基数和离职数，最后外层只输出2025年。",
      "emphasis": []
    }
  ],
