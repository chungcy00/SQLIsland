    {
      "kind": "runnable",
      "title": "统计各部门期初、期末及离职人数",
      "sql": "WITH m AS (SELECT month_key,MIN(day) first_day,MAX(day) last_day,MIN(day_index) first_idx FROM calendar_days WHERE month_key BETWEEN '2024-11' AND '2025-12' GROUP BY month_key), a AS (SELECT d.department_id,m.month_key,SUM(CASE WHEN h.start_date< m.first_day AND (h.end_date IS NULL OR h.end_date>=m.first_day) THEN 1 ELSE 0 END) opening,SUM(CASE WHEN h.start_date<=m.last_day AND (h.end_date IS NULL OR h.end_date>m.last_day) THEN 1 ELSE 0 END) closing,SUM(CASE WHEN e.termination_date BETWEEN m.first_day AND m.last_day AND h.end_date=e.termination_date THEN 1 ELSE 0 END) exits FROM departments d CROSS JOIN m LEFT JOIN employment_history h ON h.department_id=d.department_id LEFT JOIN employees e ON e.employee_id=h.employee_id GROUP BY d.department_id,m.month_key)\nSELECT * FROM a ORDER BY 1, 2, 3, 4, 5 LIMIT 3;",
      "purpose": "统计各部门期初、期末及离职人数（a）的实际执行结果。",
      "reason": "在示例数据上运行该步骤，核对中间结果后再进入下一步。",
