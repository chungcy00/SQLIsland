      "sql": "WITH suppliers(supplier_id) AS (VALUES (1),(2),(3)),\nv_po_lines(supplier_id,ordered_cents,accepted,unit_price_cents) AS (VALUES (1,1000,8,100),(1,500,5,100),(2,400,0,100)),\nv_invoice_balance(supplier_id,billed_cents,paid_cents,balance_cents) AS (VALUES (1,600,600,0),(1,800,300,500),(2,100,150,-50)), a AS (SELECT supplier_id,SUM(ordered_cents) ordered,SUM(accepted*unit_price_cents) received FROM v_po_lines GROUP BY supplier_id), b AS (SELECT supplier_id,SUM(billed_cents) billed,SUM(paid_cents) paid,SUM(balance_cents) balance FROM v_invoice_balance GROUP BY supplier_id) SELECT s.supplier_id,COALESCE(a.ordered,0) ordered_cents,COALESCE(a.received,0) received_cents,COALESCE(b.billed,0) billed_cents,COALESCE(b.paid,0) paid_cents,COALESCE(b.balance,0) balance_cents FROM suppliers s LEFT JOIN a ON a.supplier_id=s.supplier_id LEFT JOIN b ON b.supplier_id=s.supplier_id ORDER BY balance_cents DESC",
