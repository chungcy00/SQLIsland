      "sql": "WITH a AS (SELECT supplier_id,SUM(ordered_cents) ordered,SUM(accepted*unit_price_cents) received FROM v_po_lines GROUP BY supplier_id)\nSELECT * FROM a ORDER BY 1, 2, 3 LIMIT 3;",
