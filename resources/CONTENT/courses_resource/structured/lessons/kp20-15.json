{
  "schemaVersion": 1,
  "id": "kp20-15",
  "sourceBatch": "unified73",
  "teachingKind": "business",
  "conceptBlocks": [
    {
      "type": "heading",
      "text": "什么是采购敞口？",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "采购承诺、合格收货、扣贷项净开票、实际付款及未付余额是不同业务事件的金额。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "各自先聚合到供应商，再对齐；未付余额是净开票减付款，并非未收货承诺。"
      ]
    }
  ],
  "syntax": {
    "purpose": "采购承诺、收货、开票及付款敞口的语法模板如下，各部分含义见下方说明。"
  },
  "dataDescriptions": {
    "suppliers": "共 3 行；字段：supplier_id、supplier_name、region。",
    "v_invoice_balance": "共 3 行；字段：supplier_invoice_id、po_id、supplier_id、invoice_no、invoice_date、due_date、billed_cents、paid_cents、balance_cents。",
    "v_po_lines": "共 3 行；字段：po_item_id、po_id、supplier_id、warehouse_id、order_date、promised_date、product_id、quantity_ordered、unit_price_cents、ordered_cents、received、accepted、on_time、billed、billed_cents。"
  },
  "problem": "采购与财务需要截至2025年底按供应商对照承诺、合格收货、净开票、实付和未付余额，并识别已付款但三方不一致的发票。",
  "methodBlocks": [
    {
      "type": "paragraph",
      "text": "a 将采购行按供应商聚合，承诺为订购金额，收货为合格接收数量乘采购单价。b 将发票余额视图按供应商聚合，净开票已扣截止日前批准贷项，付款仅计截止日前发生的付款。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "两个汇总各自一供应商一行，再从供应商主档左连接，完整记录假设下缺失金额补零；按未付余额倒序。不能直接连接采购行与发票行，否则两笔采购与两张发票可形成四行。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "主查询未单独设置年度起点，沿用视图截至年底的累计口径，不应称为2025年度新增采购。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "追查已付款异常时切回采购行与发票行：按采购行分区，以发票日期、发票号与行编号确定先后，窗口累计此前开票量，当前分配量为不小于零的剩余合格数量与当前开票量的较小值。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "再按发票汇总原始票面、分配计价与数量差，付款在发票粒度判断，不累加重复的发票付款字段。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "此分配示例假定数量非负，发票顺序稳定，且为截止日已知收货的事后分配，不等于付款发生当时的收货状态。",
      "emphasis": []
    }
  ],
  "breakdown": [
    {
