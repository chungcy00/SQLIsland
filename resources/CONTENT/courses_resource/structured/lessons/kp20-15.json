      "sql": "WITH receipts(po_item_id,accepted,unit_price) AS (VALUES (1,8,100),(2,0,100)),\ninvoices(invoice_id,invoice_date,invoice_no,paid_cents) AS (VALUES (1,'2025-02-01','A',600),(2,'2025-02-02','B',300),(3,'2025-02-03','C',0)),\nlines(line_id,invoice_id,po_item_id,qty,price) AS (VALUES (11,1,1,6,100),(21,2,1,4,110),(31,3,2,2,100)),\nseq AS (SELECT l.*,i.paid_cents,r.accepted,r.unit_price,COALESCE(SUM(l.qty) OVER(PARTITION BY l.po_item_id ORDER BY i.invoice_date,i.invoice_no,l.line_id ROWS BETWEEN UNBOUNDED PRECEDING AND 1 PRECEDING),0) prior_qty FROM lines l JOIN invoices i ON i.invoice_id=l.invoice_id JOIN receipts r ON r.po_item_id=l.po_item_id),\nallocated AS (SELECT *,CASE WHEN accepted<=prior_qty THEN 0 WHEN accepted-prior_qty<qty THEN accepted-prior_qty ELSE qty END matched_qty FROM seq),\nchecked AS (SELECT invoice_id,MAX(paid_cents) paid_cents,SUM(qty) billed_qty,SUM(matched_qty) matched_qty,SUM(qty*price) face_cents,SUM(matched_qty*unit_price) expected_cents FROM allocated GROUP BY invoice_id) SELECT invoice_id,paid_cents,billed_qty,matched_qty,face_cents,expected_cents,face_cents-expected_cents variance_cents FROM checked WHERE paid_cents>0 AND (billed_qty<>matched_qty OR face_cents<>expected_cents) ORDER BY paid_cents DESC",
