{
  "schemaVersion": 1,
  "id": "kp20-01",
  "sourceBatch": "unified73",
  "teachingKind": "business",
  "conceptBlocks": [
    {
      "type": "heading",
      "text": "什么是销售贡献率？",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "贡献率=分组净销售额÷全部分组净销售额×100%。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "分母必须与分子采用相同期间、渠道及有效订单口径。"
      ]
    },
    {
      "type": "figure",
      "ids": [
        "kp20-01-share"
      ]
    },
    {
      "type": "heading",
      "text": "使用要点",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "先按门店汇总，再计算全体总额；全体为零时比例留空。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "净销售可能因退款为负，贡献率并不必然介于0%和100%之间。"
      ]
    }
  ],
  "syntax": {
    "purpose": "多表汇总与贡献率的语法模板如下，各部分含义见下方说明。"
  },
  "dataDescriptions": {
    "stores": "共 3 行；字段：store_id、store_name、city、fulfillment_warehouse_id。",
    "customers": "共 4 行；字段：customer_id、customer_name、signup_date、region、member_since_date。",
    "calendar_days": "共 12 行；字段：day、month_key、day_index。",
    "orders": "共 11 行；字段：order_id、store_id、customer_id、session_id、order_date、channel、status、cancellation_reason。",
    "order_items": "共 15 行；字段：order_item_id、order_id、product_id、promotion_id、quantity、unit_price_cents、discount_cents、unit_cost_cents。",
    "returns": "共 2 行；字段：return_id、order_item_id、return_date、quantity、refund_cents。"
  },
  "problem": "区域经理需要比较2025年全部实体门店对同期净销售的贡献，并保留没有销售的门店。金额采用马币分；有效订单以原项目视图为准。",
  "methodBlocks": [
    {
      "type": "paragraph",
      "text": "原查询以门店主档为左表，将渠道和日期条件放在 ON 中，避免无匹配订单的门店被 WHERE 排除。SUM 汇总订单净额，COALESCE 将无销售的门店补零。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "totals 每门店一行；SUM(net_cents) OVER() 在该层每行提供相同总体分母。NULLIF 将零分母变为空，ROUND 仅在最后保留两位小数。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "若只展示前几名，先在公用表表达式内计算比例，再在外层排序限制行数；不能先过滤门店再计算总体。类别分析需要商品销售明细及类别映射，而非将订单总额直接连接商品明细。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "独立例子直接提供净额，未重新构造原订单退款视图。",
      "emphasis": []
    }
  ],
  "breakdown": [
    {
      "kind": "runnable",
      "title": "汇总各门店净销售并保留无销售门店",
      "sql": "WITH totals AS (\n SELECT s.store_id, COALESCE(SUM(o.net_cents),0) net_cents\n FROM stores s LEFT JOIN v_order_net o ON o.store_id=s.store_id\n  AND o.channel='store' AND o.order_date BETWEEN '2025-01-01' AND '2025-12-31'\n GROUP BY s.store_id\n)\nSELECT * FROM totals ORDER BY 1, 2 LIMIT 3;",
      "purpose": "先汇总 2025 年各实体门店的线下净销售，没有销售的门店记为 0。",
      "reason": "门店表左连接订单，日期和渠道条件写在 ON 里，没有订单的门店才不会被删掉。",
