{
  "schemaVersion": 1,
  "id": "kp19-58",
  "sourceBatch": "unified73",
  "teachingKind": "business",
  "conceptBlocks": [
    {
      "type": "heading",
      "text": "什么是三方核对？",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "三方核对比较订购数量、合格收货数量、原始开票数量及金额。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "应核金额=合格收货量×采购单价；金额差=原始开票金额−应核金额。"
      ]
    },
    {
      "type": "heading",
      "text": "使用要点",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "数量不等或金额差非零均需复核，金额单位为分。",
      "emphasis": []
    },
    {
      "type": "list",
      "items": [
        "后续贷项不在本题冲减。"
      ]
    }
  ],
  "syntax": {
    "purpose": "采购、收货与发票三方核对的语法模板如下，各部分含义见下方说明。"
  },
  "dataDescriptions": {
    "supplier_invoice_items": "共 3 行；字段：supplier_invoice_item_id、supplier_invoice_id、po_item_id、quantity_billed、unit_price_cents。",
    "supplier_invoices": "共 3 行；字段：supplier_invoice_id、po_id、invoice_no、invoice_date、due_date。",
    "v_po_lines": "共 3 行；字段：po_item_id、po_id、supplier_id、warehouse_id、order_date、promised_date、product_id、quantity_ordered、unit_price_cents、ordered_cents、received、accepted、on_time、billed、billed_cents。"
  },
  "problem": "采购主管需在2025年末逐采购行识别少收、超开票、未开票及金额异常。采购行是连接键；只纳入2025年非取消采购行，发票截止2025-12-31。",
  "methodBlocks": [
    {
      "type": "paragraph",
      "text": "原主查询从已汇总的 v_po_lines 获取采购与合格收货信息；",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "billed 将截止日前发票行按采购行分别合计数量和数量乘实际开票单价的金额，checked 左连接保证未开票仍保留，缺失开票量及金额补零。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "最终用三个 OR 条件识别差异，因此金额一致也可能存在数量异常。不能把收货明细和发票明细直接连接，否则多对多会放大金额。应核金额采用合格量而非订购量；",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "原始开票金额不扣贷项，净应付另见财务核对。补充库存核对以收货记录为键，先汇总关联入库流水，再比较合格接收量；无流水且全部拒收是正常情况。",
      "emphasis": []
    },
    {
      "type": "paragraph",
      "text": "独立示例仅检查已有收货记录对应的流水，孤立流水需另做反向检查。",
      "emphasis": []
    }
  ],
  "breakdown": [
    {
      "kind": "runnable",
      "title": "统一采购行的开票数量和金额",
      "sql": "WITH billed AS (\n  SELECT x.po_item_id,SUM(x.quantity_billed) billed,SUM(x.quantity_billed*x.unit_price_cents) billed_cents\n  FROM supplier_invoice_items x JOIN supplier_invoices f ON f.supplier_invoice_id=x.supplier_invoice_id\n  WHERE f.invoice_date<='2025-12-31' GROUP BY x.po_item_id\n)\nSELECT * FROM billed ORDER BY 1, 2, 3 LIMIT 3;",
      "purpose": "先按采购行汇总截至 2025-12-31 已开票的数量和金额。",
      "reason": "一行采购可能对应多张发票，要先按采购行汇总，才能和订购、收货各是一行对应。",
