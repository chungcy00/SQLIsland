          "role": "from",
          "label": "来源",
          "sql": "FROM nullable_values",
          "note": "数据来自表 nullable_values。"
        },
        {
          "role": "where",
          "label": "筛选",
          "sql": "WHERE value <> 10",
          "note": "只保留满足这个条件的行：value <> 10。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY value;",
          "note": "按记录编号排列"
        }
