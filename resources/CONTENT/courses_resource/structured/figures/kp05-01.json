        {
          "key": 2,
          "value": 0,
          "truth": "true"
        },
        {
          "key": 3,
          "value": 10,
          "truth": "false"
        },
        {
          "key": 4,
          "value": 10,
          "truth": "false"
        }
      ],
      "replacesTable": true,
      "conclusion": "WHERE 只保留条件结果为“真”的行；“假”和“未知”都会被排除，所以 NULL 所在的行不会出现在结果里。"
    },
    {
      "id": "kp05-01-clauses",
      "slot": "syntax",
      "kind": "clause-map",
      "title": "示例查询的四个部分",
      "sql": "SELECT id, value FROM nullable_values WHERE value <> 10 ORDER BY value;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT id, value",
