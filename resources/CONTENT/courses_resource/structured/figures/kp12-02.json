      "title": "示例查询的几个部分",
      "sql": "SELECT id, strftime('%Y-%m',order_date) AS month, CAST(strftime('%Y',order_date) AS INTEGER) AS year_no, CAST(strftime('%m',order_date) AS INTEGER) AS month_no FROM orders ORDER BY sales DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT id, strftime('%Y-%m',order_date) AS month, CAST(strftime('%Y',order_date) AS INTEGER) AS year_no, CAST(strftime('%m',order_date) AS INTEGER) AS month_no",
          "note": "结果表最终显示 4 列：id、month、year_no、month_no。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM orders",
          "note": "数据来自表 orders。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY sales DESC;",
          "note": "按 sales DESC 排列结果。"
        }
      ]
