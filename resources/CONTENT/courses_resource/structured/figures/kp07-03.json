      "title": "示例查询的几个部分",
      "sql": "SELECT store_id, category, SUM(sales) AS total FROM orders GROUP BY store_id, category ORDER BY total DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT store_id, category, SUM(sales) AS total",
          "note": "结果表最终显示 3 列：store_id、category、total。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM orders",
          "note": "数据来自表 orders。"
        },
        {
          "role": "group",
          "label": "分组",
          "sql": "GROUP BY store_id, category",
          "note": "按 store_id, category 把行归入各个分组。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY total DESC;",
