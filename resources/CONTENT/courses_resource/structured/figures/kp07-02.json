      "id": "kp07-02-clauses",
      "slot": "syntax",
      "kind": "clause-map",
      "title": "示例查询的几个部分",
      "sql": "SELECT category, SUM(sales) AS total_sales FROM orders GROUP BY category HAVING SUM(sales) > 1000 ORDER BY total_sales DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT category, SUM(sales) AS total_sales",
          "note": "结果表最终显示 2 列：category、total_sales。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM orders",
          "note": "数据来自表 orders。"
        },
        {
          "role": "group",
          "label": "分组",
          "sql": "GROUP BY category",
          "note": "按 category 把行归入各个分组。"
        },
        {
          "role": "having",
          "label": "分组后筛选",
          "sql": "HAVING SUM(sales) > 1000",
          "note": "仅保留满足 SUM(sales) > 1000 的分组。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY total_sales DESC;",
          "note": "按 total_sales DESC 排列结果。"
        }
      ]
    },
