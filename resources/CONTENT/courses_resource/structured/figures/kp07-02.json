                  "化妆品",
                  300
                ],
                [
                  5,
                  "日用品",
                  1500
                ]
              ],
              "source": "orders",
              "sql": "SELECT id, category, sales FROM orders ORDER BY id",
              "ordered": true
            }
          ]
        },
        {
          "label": "② 处理中：分组后每组的合计（3 组）",
          "via": "GROUP BY category 并计算 SUM(sales)",
          "note": "HAVING 在这里，对每一组的合计做判断。",
          "tables": [
            {
              "columns": [
                "category",
                "total_sales"
              ],
              "rows": [
                [
                  "化妆品",
                  700
                ],
                [
                  "护肤品",
                  1400
                ],
                [
                  "日用品",
                  1500
                ]
              ],
              "tags": [
                {
                  "text": "不满足 · 整组去掉",
                  "tone": "skip"
                },
                {
                  "text": "满足 · 保留",
                  "tone": "take"
                },
                {
                  "text": "满足 · 保留",
                  "tone": "take"
                }
              ],
              "sql": "SELECT category, SUM(sales) AS total_sales FROM orders GROUP BY category ORDER BY category",
              "ordered": true
            }
          ]
        },
        {
          "label": "③ 处理后：留下的组（2 行）",
          "via": "HAVING SUM(sales) > 1000：只留下合计大于 1000 的组",
          "tables": [
            {
              "columns": [
                "category",
                "total_sales"
              ],
              "rows": [
                [
                  "日用品",
                  1500
                ],
                [
                  "护肤品",
                  1400
                ]
              ],
              "sql": "SELECT category, SUM(sales) AS total_sales FROM orders GROUP BY category HAVING SUM(sales) > 1000 ORDER BY total_sales DESC;",
              "ordered": true
            }
          ]
        }
      ],
      "conclusion": "WHERE 筛选的是分组前的每一行；HAVING 筛选的是分组后的每一组，要用到 SUM 这类汇总值时只能用 HAVING。"
