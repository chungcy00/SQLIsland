      "title": "WHERE 与 HAVING：一个筛行，一个筛组",
      "stages": [
        {
          "label": "① 处理前：orders（5 行）",
          "note": "WHERE 在这里逐行筛选；本例没有写 WHERE，5 行全部进入分组。",
          "tables": [
            {
              "columns": [
                "id",
                "category",
                "sales"
              ],
              "rows": [
                [
                  1,
                  "护肤品",
                  800
