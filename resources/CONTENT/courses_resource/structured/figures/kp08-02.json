    {
      "id": "kp08-02-clauses",
      "slot": "syntax",
      "kind": "clause-map",
      "title": "示例查询的几个部分",
      "sql": "SELECT c.customer_id, o.id AS order_id, o.sales FROM customers c LEFT JOIN orders o ON c.customer_id=o.customer_id ORDER BY o.sales DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT c.customer_id, o.id AS order_id, o.sales",
          "note": "结果表最终显示 3 列：customer_id、order_id、sales。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM customers c LEFT JOIN orders o ON c.customer_id=o.customer_id",
          "note": "数据来自 表 customers、表 orders，并用 ON 后面的条件把它们的行配起来。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY o.sales DESC;",
          "note": "按 o.sales DESC 排列结果。"
        }
      ]
    },
