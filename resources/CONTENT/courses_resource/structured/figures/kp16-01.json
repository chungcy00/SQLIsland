  "figures": [
    {
      "id": "kp16-01-clauses",
      "slot": "syntax",
      "kind": "clause-map",
      "title": "示例查询的几个部分",
      "sql": "SELECT TRIM(name) AS clean_name,amount,LOWER(category) AS clean_category,COUNT(*) AS duplicate_count FROM raw_data GROUP BY TRIM(name),amount,LOWER(category) HAVING COUNT(*)>1;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT TRIM(name) AS clean_name,amount,LOWER(category) AS clean_category,COUNT(*) AS duplicate_count",
          "note": "结果表最终显示 4 列：clean_name、amount、clean_category、duplicate_count。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM raw_data",
          "note": "数据来自表 raw_data。"
        },
        {
          "role": "group",
          "label": "分组",
          "sql": "GROUP BY TRIM(name),amount,LOWER(category)",
          "note": "按 TRIM(name),amount,LOWER(category) 把行归入各个分组。"
        },
        {
          "role": "having",
          "label": "分组后筛选",
          "sql": "HAVING COUNT(*)>1;",
          "note": "仅保留满足 COUNT(*)>1 的分组。"
        }
      ]
    },
    {
