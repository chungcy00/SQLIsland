          "label": "来源",
          "sql": "FROM customers",
          "note": "从 customers 读取输入数据。"
        },
        {
          "role": "where",
          "label": "筛选",
          "sql": "WHERE customer_id IN (SELECT customer_id FROM orders WHERE sales >= 600)",
          "note": "仅保留满足条件的行。"
