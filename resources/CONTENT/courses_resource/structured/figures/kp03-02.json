      "title": "示例查询的几个部分",
      "sql": "SELECT product_id FROM products WHERE (price < 40 OR stock > 100) AND NOT stock = 0 ORDER BY product_name DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT product_id",
          "note": "结果表最终显示 1 列：product_id。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM products",
          "note": "数据来自表 products。"
        },
        {
          "role": "where",
          "label": "筛选",
          "sql": "WHERE (price < 40 OR stock > 100) AND NOT stock = 0",
          "note": "只保留满足这个条件的行：(price < 40 OR stock > 100) AND NOT stock = 0。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY product_name DESC;",
          "note": "按 product_name DESC 排列结果。"
