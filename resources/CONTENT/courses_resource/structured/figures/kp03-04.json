                    },
                    {
                      "text": "没有下划线 · 去掉",
                      "tone": "skip"
                    },
                    {
                      "text": "含真正的下划线 · 留",
                      "tone": "take"
                    }
                  ],
                  "sql": "SELECT product_id, product_name FROM products ORDER BY product_id",
                  "ordered": true
                }
              ]
            },
            {
              "label": "③ 处理后：名称里真有下划线的（1 行）",
              "tables": [
                {
                  "columns": [
                    "product_name"
                  ],
                  "rows": [
                    [
                      "Soap_1"
                    ]
                  ],
                  "sql": "SELECT product_name FROM products WHERE product_name LIKE '%!_%' ESCAPE '!' ORDER BY product_name DESC;",
                  "ordered": true
                }
              ]
            }
          ],
          "conclusion": "转义后，只有名称里真的有“_”的 Soap_1 被找到。"
        },
