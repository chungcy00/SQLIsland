      "kind": "flow-map",
      "title": "LIKE：通配符有特殊含义，找真正的 _ 要转义",
      "variants": [
        {
          "label": "转义（本例）",
          "stages": [
            {
              "label": "① 处理前：products（6 行）",
              "tables": [
                {
                  "columns": [
                    "product_id",
                    "product_name"
                  ],
                  "rows": [
