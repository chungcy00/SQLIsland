            },
            {
              "label": "② 逐行匹配：LIKE '%!_%' ESCAPE '!'",
              "via": "ESCAPE '!'：! 后面的 _ 当作普通的下划线字符，不再是通配符",
              "tables": [
                {
                  "columns": [
