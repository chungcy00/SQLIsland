          "big": {
            "label": "SUM(stock)：总库存",
            "value": 650
          },
          "check": {
            "sql": "SELECT SUM(stock) FROM products",
            "expected": [
              [
                650
              ]
            ]
          },
          "note": "数量可以相加，得到总库存（件）。"
