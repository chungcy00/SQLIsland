      "title": "示例查询的几个部分",
      "sql": "SELECT id, IFNULL(value, -1) AS filled, COALESCE(note, 'missing') AS note_filled FROM nullable_values ORDER BY filled DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT id, IFNULL(value, -1) AS filled, COALESCE(note, 'missing') AS note_filled",
          "note": "输出 id；IFNULL 把缺失的 value 换成 -1，COALESCE 把缺失的 note 换成 'missing'"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM nullable_values",
          "note": "读取 nullable_values 表"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY filled DESC;",
          "note": "按 id 排列"
        }
      ]
