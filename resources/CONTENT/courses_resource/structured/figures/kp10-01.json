                  45
                ],
                [
                  6,
                  15
                ]
              ],
              "source": "products",
              "tags": [
                {
                  "text": "15 不大于 44 · 去掉",
                  "tone": "skip"
                },
                {
                  "text": "89 > 44 · 留",
                  "tone": "take"
                },
                {
                  "text": "35 不大于 44 · 去掉",
                  "tone": "skip"
                },
                {
                  "text": "65 > 44 · 留",
                  "tone": "take"
                },
                {
                  "text": "45 > 44 · 留",
                  "tone": "take"
                },
                {
                  "text": "15 不大于 44 · 去掉",
                  "tone": "skip"
                }
              ],
              "sql": "SELECT product_id, price FROM products ORDER BY product_id",
              "ordered": true
            }
          ]
        },
        {
          "label": "③ 处理后：留下的行（3 行）",
          "via": "只留下比较为真的行，再 ORDER BY price",
          "tables": [
