      "title": "示例查询的几个部分",
      "sql": "SELECT product_id, price FROM products WHERE price > (SELECT AVG(price) FROM products) ORDER BY price;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT product_id, price",
          "note": "结果表最终显示 2 列：product_id、price。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM products",
          "note": "数据来自表 products。"
        },
        {
          "role": "where",
          "label": "筛选",
          "sql": "WHERE price > (SELECT AVG(price) FROM products)",
          "note": "只保留满足这个条件的行：price > (SELECT AVG(price) FROM products)。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY price;",
          "note": "按 price 排列结果。"
        }
