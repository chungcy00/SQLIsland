      "kind": "clause-map",
      "title": "示例查询的几个部分",
      "sql": "SELECT e.employee_name, m.employee_name AS manager FROM employees e LEFT JOIN employees m ON e.manager_id=m.employee_id ORDER BY e.salary, e.employee_name;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT e.employee_name, m.employee_name AS manager",
          "note": "结果表最终显示 2 列：employee_name、manager。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM employees e LEFT JOIN employees m ON e.manager_id=m.employee_id",
          "note": "数据来自 表 employees、表 employees，并用 ON 后面的条件把它们的行配起来。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY e.salary, e.employee_name;",
          "note": "按 e.salary, e.employee_name 排列结果。"
        }
      ]
