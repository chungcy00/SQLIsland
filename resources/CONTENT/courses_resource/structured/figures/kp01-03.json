      "id": "kp01-03-clauses",
      "slot": "syntax",
      "kind": "clause-map",
      "title": "示例查询的几个部分",
      "sql": "SELECT c.customer_id, COUNT(o.id) AS order_count FROM customers c LEFT JOIN orders o ON c.customer_id=o.customer_id GROUP BY c.customer_id ORDER BY order_count DESC, SUM(o.sales) DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT c.customer_id, COUNT(o.id) AS order_count",
          "note": "结果表最终显示 2 列：customer_id、order_count。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM customers c LEFT JOIN orders o ON c.customer_id=o.customer_id",
          "note": "数据来自 表 customers、表 orders，并用 ON 后面的条件把它们的行配起来。"
        },
        {
          "role": "group",
          "label": "分组",
          "sql": "GROUP BY c.customer_id",
          "note": "每位客户汇总成一行"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY order_count DESC, SUM(o.sales) DESC;",
          "note": "按客户编号排列"
        }
      ]
    },
