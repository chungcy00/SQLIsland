    {
      "id": "kp01-01-map",
      "slot": "concept",
      "kind": "compare-card",
      "title": "一行代表什么，决定了怎么数",
      "panels": [
        {
          "label": "把订单行数当成客户数",
          "tone": "bad",
          "columns": [
            "id",
            "customer_id"
          ],
          "rows": [
            [
              1,
              1
            ],
            [
              2,
              2
            ],
            [
              3,
              1
            ],
            [
              4,
              null
            ],
            [
              5,
              3
            ]
          ],
          "big": {
            "label": "COUNT(*)：订单行数",
            "value": 5
          },
          "check": {
            "sql": "SELECT COUNT(*) FROM orders",
            "expected": [
              [
                5
              ]
            ]
          },
          "note": "orders 一行是一笔订单：同一位客户（如 1）有两行。"
        },
        {
          "label": "数不同的客户编号",
          "tone": "good",
          "columns": [
            "customer_id"
          ],
          "rows": [
            [
              1
            ],
            [
              2
            ],
            [
              3
            ]
          ],
          "big": {
            "label": "COUNT(DISTINCT customer_id)：客户数",
            "value": 3
          },
          "check": {
            "sql": "SELECT COUNT(DISTINCT customer_id) FROM orders",
            "expected": [
              [
                3
              ]
            ]
          },
          "note": "没有客户编号（NULL）的匿名订单不算在内。"
        }
      ],
      "conclusion": "5 笔订单只来自 3 位有编号的客户：记录数并不等于客户数。"
    }
  ]
