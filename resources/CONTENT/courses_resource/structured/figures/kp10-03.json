          "role": "from",
          "label": "来源",
          "sql": "FROM customers c",
          "note": "从 customers c 读取输入数据。"
        },
        {
          "role": "where",
          "label": "筛选",
          "sql": "WHERE EXISTS (SELECT 1 FROM orders o WHERE o.customer_id=c.customer_id)",
          "note": "仅保留满足条件的行。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY customer_name DESC;",
