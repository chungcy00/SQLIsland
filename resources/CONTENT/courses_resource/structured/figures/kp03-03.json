              "sql": "SELECT product_id AS id, category, price, CASE WHEN category IN ('护肤品','化妆品') THEN '是' ELSE '否' END AS \"IN\", CASE WHEN price BETWEEN 35 AND 65 THEN '是' ELSE '否' END AS \"BETWEEN\", CASE WHEN category IN ('护肤品','化妆品') AND price BETWEEN 35 AND 65 THEN '留' ELSE '去掉' END AS \"结果\" FROM products ORDER BY product_id",
