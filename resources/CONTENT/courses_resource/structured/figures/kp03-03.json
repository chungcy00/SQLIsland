        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT product_id, price",
          "note": "结果表最终显示 2 列：product_id、price。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM products",
          "note": "数据来自表 products。"
        },
        {
          "role": "where",
          "label": "筛选",
          "sql": "WHERE category IN ('护肤品','化妆品') AND price BETWEEN 35 AND 65",
          "note": "只保留满足这个条件的行：category IN ('护肤品','化妆品') AND price BETWEEN 35 AND 65。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY price DESC;",
          "note": "按 price DESC 排列结果。"
