      "slot": "syntax",
      "kind": "clause-map",
      "title": "示例查询的几个部分",
      "sql": "SELECT o.id, c.customer_name FROM orders o INNER JOIN customers c ON o.customer_id=c.customer_id ORDER BY sales DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT o.id, c.customer_name",
          "note": "结果表最终显示 2 列：id、customer_name。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM orders o INNER JOIN customers c ON o.customer_id=c.customer_id",
          "note": "数据来自 表 orders、表 customers，并用 ON 后面的条件把它们的行配起来。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY sales DESC;",
          "note": "按 sales DESC 排列结果。"
        }
      ]
