    {
      "id": "kp04-02-clauses",
      "slot": "syntax",
      "kind": "clause-map",
      "title": "示例查询的几个部分",
      "sql": "SELECT product_id, price FROM products ORDER BY price DESC, product_name LIMIT 3 OFFSET 2;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT product_id, price",
          "note": "结果表最终显示 2 列：product_id、price。"
        },
        {
          "role": "from",
          "label": "来源",
          "sql": "FROM products",
          "note": "数据来自表 products。"
        },
        {
          "role": "order",
          "label": "排序",
          "sql": "ORDER BY price DESC, product_name",
          "note": "按 price DESC, product_name 排列结果。"
        },
        {
          "role": "limit",
          "label": "截取",
          "sql": "LIMIT 3 OFFSET 2;",
          "note": "先跳过前 2 条记录，再最多取出 3 条记录。"
        }
      ]
    },
