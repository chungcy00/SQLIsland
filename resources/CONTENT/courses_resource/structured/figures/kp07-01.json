        {
          "role": "from",
          "label": "来源",
          "sql": "FROM orders",
          "note": "数据来自表 orders。"
        },
        {
          "role": "group",
          "label": "分组",
          "sql": "GROUP BY category",
          "note": "按 category 把行归入各个分组。"
        },
        {
          "role": "order",
          "label": "排序",
