      "title": "示例查询的几个部分",
      "sql": "SELECT product_id,price FROM products WHERE price=89 ORDER BY product_name DESC;",
      "parts": [
        {
          "role": "select",
          "label": "取数",
          "sql": "SELECT product_id,price",
