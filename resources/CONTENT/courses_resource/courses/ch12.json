    {
      "id": "kp12-03",
      "chapterId": "ch12",
      "title": "DATEDIFF 与 TIMESTAMPDIFF",
      "learningObjective": "能够运用本节知识完成：计算交付延误、账龄",
      "prerequisites": [
        "kp12-02"
      ],
      "concept": "DATEDIFF(a,b) 计算日期部分之差；TIMESTAMPDIFF(unit,start,end) 按指定单位计算完整差值。",
      "syntax": "DATEDIFF(end_date,start_date); TIMESTAMPDIFF(DAY,start_date,end_date)",
      "parameters": {
        "DAY": "差值单位",
        "start_date,end_date": "起止日期"
      },
      "fixtureIds": [],
      "sourceTables": [],
      "mysqlSql": "SELECT DATEDIFF('2026-02-03','2026-01-31') AS days, TIMESTAMPDIFF(DAY,'2026-01-31','2026-02-03') AS elapsed;",
      "sqliteSql": "SELECT CAST(julianday('2026-02-03')-julianday('2026-01-31') AS INTEGER) AS days, CAST(julianday('2026-02-03')-julianday('2026-01-31') AS INTEGER) AS elapsed;",
      "executionSteps": [
        "固定两个日期",
        "计算跨月天数",
        "输出3"
      ],
      "useCase": "计算交付延误、账龄",
      "comparison": "两个函数参数方向不同；月差不等于天数除30。",
      "commonError": {
        "example": "DATEDIFF(start_date,end_date) 期待正数",
        "correction": "DATEDIFF(end_date,start_date)"
      },
      "notes": "本例不含时刻；时区和月差须独立实现。",
      "compatibility": {
        "status": "转换执行",
        "detail": "需要明确转换或原生环境验证。"
