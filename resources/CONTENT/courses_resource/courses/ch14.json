      "teaching": {
        "problem": "多层筛选逻辑可以先命名中间结果，再用同一口径引用。",
        "codeExplanation": "第一个 CTE 汇总类别，后一个对汇总值筛选，外层专注于输出与排序。CTE 是当前语句内的关系，并不自动保存结果。",
        "resultExplanation": "结果保留达到阈值的类别。先单独预览 totals 可定位分组口径，再测试 qualified 是否正确筛选。",
        "checkpoints": [
          {
            "name": "totals",
            "label": "类别销售汇总",
            "sql": "WITH totals AS (SELECT category,SUM(sales) AS total FROM orders GROUP BY category)\nSELECT * FROM totals ORDER BY 1, 2 LIMIT 3;",
            "result": {
              "columns": [
                "category",
                "total"
              ],
              "rows": [
                [
                  "化妆品",
                  700
                ],
                [
                  "护肤品",
                  1400
                ],
                [
                  "日用品",
                  1500
                ]
              ]
            }
          },
          {
            "name": "qualified",
            "label": "保留达到阈值的类别",
            "sql": "WITH totals AS (SELECT category,SUM(sales) AS total FROM orders GROUP BY category), qualified AS (SELECT category,total FROM totals WHERE total>1000)\nSELECT * FROM qualified ORDER BY 1, 2 LIMIT 3;",
            "result": {
