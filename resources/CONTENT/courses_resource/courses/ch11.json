      "teaching": {
        "problem": "编码前缀要按字符位置提取，不能凭样例结果硬截固定字节。",
        "codeExplanation": "SUBSTRING 从第一个字符起取三个字符，适合固定长度前缀；分隔符位置变化时先定位再截取。CHAR_LENGTH 计算字符数，LENGTH 在 MySQL 中计算字节数；多字节商品名应按字符截取。",
        "resultExplanation": "Mask 取 Mas，Serum 取 Ser。分组使用前缀前应检查是否把不同业务含义的编码误合并。",
        "checkpoints": [],
        "mergedConcepts": [
          {
            "sourceId": "kp11-04",
            "explanation": "字符限制用 CHAR_LENGTH，接口字节预算在 MySQL 中用 LENGTH。以 UTF-8 的“古晋”为例，2 个字符占 6 字节；SQLite 对 TEXT 的 length 数字符，转成 BLOB 后才数编码字节。"
          }
        ],
        "mergeExamples": [
          {
            "label": "同一名称的字符数与字节数",
            "explanation": "条件是 UTF-8 编码。SQLite 中转为 BLOB 可核对字节长度；MySQL 使用 CHAR_LENGTH 数字符，LENGTH 数字节。",
            "sql": "SELECT LENGTH('古晋') AS character_count,\n  LENGTH(CAST('古晋' AS BLOB)) AS byte_count;",
            "result": {
              "columns": [
                "character_count",
                "byte_count"
              ],
              "rows": [
                [
                  2,
                  6
                ]
              ]
            }
          }
        ]
      }
